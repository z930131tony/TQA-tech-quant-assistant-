# LINE Messaging API 設定 (填寫後請儲存為 .env)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_USER_ID=your_user_id_here

# 永豐金 Shioaji API (大戶投程式下單)
SHIOAJI_API_KEY=your_api_key_here
SHIOAJI_SECRET_KEY=your_secret_key_here
SHIOAJI_CERT_PATH=sinopac.pfx
SHIOAJI_CERT_PASSWORD=your_cert_password
SHIOAJI_PERSON_ID=your_person_id
SHIOAJI_SIMULATION=true

# 雲端持倉設定 (第二梯隊：手機即時維護，免動 Git，留空則自動使用本地 portfolio.json)
# Google Sheets 發布為 CSV 之網址 (推薦，手機開試算表直接改)
PORTFOLIO_SHEET_URL=

# Google Gemini API Key (選填，TradingAgents AI 多空對抗辯論使用，留空則自動降級為量化規則合成)
GEMINI_API_KEY=
